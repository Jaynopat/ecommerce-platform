{
  "info": {
    "name": "MultiVend E-Commerce Platform",
    "description": "Complete API collection for the Multi-Vendor E-Commerce Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "buyer_token", "value": "" },
    { "key": "seller_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Buyer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"buyer@test.com\",\n  \"password\": \"Password123\",\n  \"role\": \"buyer\"\n}" }
          }
        },
        {
          "name": "Register Seller",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"seller@test.com\",\n  \"password\": \"Password123\",\n  \"role\": \"seller\"\n}" }
          }
        },
        {
          "name": "Login Buyer",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.environment.set('buyer_token', pm.response.json().token);"] }
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"buyer@test.com\",\n  \"password\": \"Password123\"\n}" }
          }
        },
        {
          "name": "Login Seller",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.environment.set('seller_token', pm.response.json().token);"] }
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"seller@test.com\",\n  \"password\": \"Password123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seller_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"High quality sound\",\n  \"price\": 149.99,\n  \"category\": \"Electronics\",\n  \"stock\": 50\n}" }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer_token}}" }]
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products?search=headphones",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{\n    \"productId\": \"<product_id>\",\n    \"productName\": \"Wireless Headphones\",\n    \"quantity\": 1,\n    \"unitPrice\": 149.99,\n    \"sellerId\": \"<seller_id>\",\n    \"storeId\": \"<store_id>\"\n  }],\n  \"shippingAddress\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"Toronto\",\n    \"province\": \"ON\",\n    \"postalCode\": \"M5V 2T6\",\n    \"country\": \"CA\"\n  }\n}" }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Pay for Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/pay",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"<order_id>\",\n  \"paymentIntentId\": \"pi_test_123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Shipping",
      "item": [
        {
          "name": "Create Shipment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/shipping/shipments",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seller_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"<order_id>\",\n  \"buyerId\": \"<buyer_id>\",\n  \"carrier\": \"FedEx\"\n}" }
          }
        },
        {
          "name": "Mark Delivered",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/shipping/shipments/<shipment_id>/deliver",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/reviews",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"<order_id>\",\n  \"productId\": \"<product_id>\",\n  \"rating\": 5,\n  \"comment\": \"Excellent product!\"\n}" }
          }
        },
        {
          "name": "Get Product Reviews",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reviews/<product_id>",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer_token}}" }]
          }
        },
        {
          "name": "Get Pending Reviews (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reviews/pending",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }]
          }
        },
        {
          "name": "Approve Review (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/reviews/<review_id>/approve",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Stock",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/inventory",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seller_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"<product_id>\",\n  \"quantity\": 100,\n  \"lowStockThreshold\": 10\n}" }
          }
        },
        {
          "name": "Get Stock",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/inventory/<product_id>",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/analytics/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Messaging",
      "item": [
        {
          "name": "Get Messages for Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/messages/<order_id>",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer_token}}" }]
          }
        }
      ]
    }
  ]
}